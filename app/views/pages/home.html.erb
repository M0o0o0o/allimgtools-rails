          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="font-semibold text-sm text-base-content"><%= t("nav.exif_edit") %></div>
          <div class="text-xs text-base-content/55 mt-0.5 leading-relaxed"><%= t("home.exif_edit_desc") %></div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-base-content/20 transition-colors group-hover:text-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>

      <%# Convert — spans full width to avoid a lone orphan card %>
      <%= link_to new_convert_path, class: "group sm:col-span-2 flex items-center gap-4 rounded-2xl border border-base-200 bg-base-100 p-5 transition-all hover:border-primary/30 hover:shadow-md" do %>
