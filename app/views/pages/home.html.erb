          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="font-semibold text-sm text-base-content"><%= t("nav.compress") %></div>
          <div class="text-xs text-base-content/55 mt-0.5 leading-relaxed"><%= t("home.compress_desc") %></div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-base-content/20 transition-colors group-hover:text-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>

      <%= link_to new_resize_path, class: "group flex items-center gap-4 rounded-2xl border border-base-200 bg-base-100 p-5 transition-all hover:border-primary/30 hover:shadow-md" do %>
        <div class="shrink-0 rounded-xl bg-primary/10 p-3 transition-colors group-hover:bg-primary/15">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="font-semibold text-sm text-base-content"><%= t("nav.resize") %></div>
          <div class="text-xs text-base-content/55 mt-0.5 leading-relaxed"><%= t("home.resize_desc") %></div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-base-content/20 transition-colors group-hover:text-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>

      <%= link_to new_rotate_path, class: "group flex items-center gap-4 rounded-2xl border border-base-200 bg-base-100 p-5 transition-all hover:border-primary/30 hover:shadow-md" do %>
        <div class="shrink-0 rounded-xl bg-primary/10 p-3 transition-colors group-hover:bg-primary/15">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="font-semibold text-sm text-base-content"><%= t("nav.rotate") %></div>
          <div class="text-xs text-base-content/55 mt-0.5 leading-relaxed"><%= t("home.rotate_desc") %></div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-base-content/20 transition-colors group-hover:text-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>

      <%= link_to new_crop_path, class: "group flex items-center gap-4 rounded-2xl border border-base-200 bg-base-100 p-5 transition-all hover:border-primary/30 hover:shadow-md" do %>
        <div class="shrink-0 rounded-xl bg-primary/10 p-3 transition-colors group-hover:bg-primary/15">
