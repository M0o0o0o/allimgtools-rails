          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>

      <%= link_to new_exif_path, class: "group flex items-center gap-4 rounded-2xl border border-base-200 bg-base-100 p-5 transition-all hover:border-primary/30 hover:shadow-md" do %>
        <div class="shrink-0 rounded-xl bg-primary/10 p-3 transition-colors group-hover:bg-primary/15">
