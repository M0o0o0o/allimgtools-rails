<% content_for :title, t("home.meta_title") %>
<% content_for :description, t("home.meta_description") %>
<% content_for :main_class, "flex-1" %>
<% content_for :head do %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Allimgtools",
    "url": "https://allimgtools.com",
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "description": "Free online image tools. Compress, resize, rotate, crop, convert, and edit EXIF metadata. No signup required."
  }
  </script>
<% end %>

<%# ─── Hero ──────────────────────────────────────────────────────────── %>
<section class="relative overflow-hidden bg-base-100 border-b border-base-200">

  <div class="absolute inset-0 opacity-60"
       style="background-image: radial-gradient(circle, oklch(55% 0.22 255 / 0.12) 1px, transparent 1px); background-size: 24px 24px;"
       aria-hidden="true"></div>

  <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_65%_at_50%_-10%,oklch(55%_0.22_255_/_0.18),transparent_70%)]"
       aria-hidden="true"></div>

  <div class="relative mx-auto max-w-3xl px-6 pt-16 pb-14 text-center">

    <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-100/90 px-4 py-1.5 text-sm font-medium text-base-content/60 shadow-sm backdrop-blur-sm">
      <span class="h-2 w-2 animate-pulse rounded-full bg-primary"></span>
      <%= t("home.trust_2") %>&ensp;·&ensp;<%= t("home.trust_1") %>
    </div>

    <h1 class="mb-5 text-5xl font-extrabold leading-[1.1] tracking-tight text-base-content sm:text-6xl">
      <%= t("home.title") %>
    </h1>

    <p class="mx-auto mb-10 max-w-md text-lg leading-relaxed text-base-content/55">
      <%= t("home.description") %>
    </p>

    <div class="flex flex-wrap items-center justify-center gap-2.5">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-base-200 px-3.5 py-1.5 text-xs font-medium text-base-content/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <%= t("home.trust_5") %>
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-base-200 px-3.5 py-1.5 text-xs font-medium text-base-content/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <%= t("home.trust_3") %>
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-base-200 px-3.5 py-1.5 text-xs font-medium text-base-content/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <%= t("home.trust_4") %>
      </span>
    </div>

  </div>
</section>

<%# ─── Tool cards ─────────────────────────────────────────────────────── %>
<section class="py-12">
  <div class="mx-auto max-w-3xl px-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

      <%= link_to new_compress_path, class: "group flex items-center gap-4 rounded-2xl border border-base-200 bg-base-100 p-5 transition-all hover:border-primary/30 hover:shadow-md" do %>
