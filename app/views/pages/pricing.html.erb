<% content_for :title, t("pricing.meta_title") %>
<% content_for :description, t("pricing.meta_description") %>
<% if authenticated? && !Current.user.subscribed? %>
  <% content_for :head do %>
    <script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
  <% end %>
<% end %>

<div class="max-w-4xl mx-auto px-4 py-16" data-controller="pricing">

  <%# Header %>
  <div class="text-center mb-10">
    <div class="inline-flex items-center gap-2 bg-primary/8 text-primary text-xs font-semibold px-3 py-1.5 rounded-full mb-5">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
      </svg>
      Simple pricing
    </div>
    <h1 class="text-4xl font-bold mb-4 tracking-tight"><%= t("pricing.title") %></h1>
    <p class="text-base-content/50 text-lg"><%= t("pricing.subtitle") %></p>
  </div>

  <%# Monthly / Yearly toggle %>
  <div class="flex items-center justify-center gap-3 mb-12">
    <span class="text-sm font-medium text-base-content"><%= t("pricing.toggle_monthly") %></span>
    <input type="checkbox" class="toggle toggle-primary"
           data-action="change->pricing#toggle">
    <span class="text-sm font-medium text-base-content flex items-center gap-2">
      <%= t("pricing.toggle_yearly") %>
      <span class="badge badge-primary badge-sm font-bold"><%= t("pricing.save_badge") %></span>
    </span>
  </div>

  <%# Cards %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-2xl mx-auto mb-24">

    <%# Free card %>
    <div class="bg-base-100 rounded-2xl border border-base-200 p-8 flex flex-col shadow-sm">
      <div class="mb-8">
        <p class="text-xs font-bold text-base-content/40 uppercase tracking-widest mb-4"><%= t("pricing.free.label") %></p>
        <div class="flex items-end gap-1.5 mb-2">
          <span class="text-5xl font-extrabold tracking-tight text-base-content"><%= t("pricing.free.price") %></span>
          <span class="text-base-content/40 mb-2 text-sm"><%= t("pricing.free.per_month") %></span>
        </div>
        <p class="text-sm text-base-content/45"><%= t("pricing.free.tagline") %></p>
      </div>

      <ul class="flex flex-col gap-3.5 flex-1 mb-8">
        <% [
          t("pricing.free.feature_tools"),
          t("pricing.free.feature_files"),
          t("pricing.free.feature_size"),
          t("pricing.free.feature_account"),
          t("pricing.free.feature_privacy"),
        ].each do |feature| %>
          <li class="flex items-center gap-3 text-sm text-base-content/70">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-base-200">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <%= feature %>
          </li>
        <% end %>
      </ul>

      <div class="btn btn-ghost w-full cursor-default text-base-content/40 border border-base-200">
        <% if authenticated? && Current.user.subscribed? %>
          <%= t("pricing.free.button_downgrade") %>
        <% else %>
          <%= t("pricing.free.button_current") %>
        <% end %>
      </div>
    </div>

    <%# Pro card %>
    <div class="relative flex flex-col rounded-2xl shadow-lg shadow-primary/10 overflow-hidden border-2 border-primary">

      <%# Gradient header %>
      <div class="bg-gradient-to-br from-primary to-primary/70 px-8 pt-8 pb-7 relative overflow-hidden">
        <div class="absolute -right-4 -top-4 h-20 w-20 rounded-full bg-white/10"></div>
        <div class="absolute right-6 bottom-0 h-12 w-12 rounded-full bg-white/5"></div>

        <div class="relative">
          <div class="flex items-center justify-between mb-4">
            <p class="text-xs font-bold text-white/70 uppercase tracking-widest"><%= t("pricing.pro.label") %></p>
            <span class="bg-white/20 text-white text-xs font-bold px-2.5 py-1 rounded-full backdrop-blur-sm"><%= t("pricing.pro.badge") %></span>
          </div>

          <%# Monthly price %>
          <div data-pricing-target="monthly">
            <div class="flex items-end gap-1.5 mb-2">
              <span class="text-5xl font-extrabold tracking-tight text-white"><%= t("pricing.pro.price") %></span>
              <span class="text-white/60 mb-2 text-sm"><%= t("pricing.pro.per_month") %></span>
            </div>
            <p class="text-sm text-white/60"><%= t("pricing.pro.tagline") %></p>
          </div>

          <%# Yearly price %>
          <div class="hidden" data-pricing-target="yearly">
            <div class="flex items-end gap-1.5 mb-2">
              <span class="text-5xl font-extrabold tracking-tight text-white"><%= t("pricing.pro.price_yearly") %></span>
              <span class="text-white/60 mb-2 text-sm"><%= t("pricing.pro.per_year") %></span>
            </div>
            <p class="text-sm text-white/60"><%= t("pricing.pro.tagline_yearly") %></p>
          </div>
        </div>
      </div>

      <%# Features %>
      <div class="bg-base-100 px-8 pt-7 pb-8 flex flex-col flex-1">
        <ul class="flex flex-col gap-3.5 flex-1 mb-8">
          <li class="flex items-center gap-3 text-sm font-medium text-base-content">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <%= t("pricing.pro.feature_tools") %>
          </li>
          <li class="flex items-start gap-3 text-sm font-medium text-base-content">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span><%= t("pricing.pro.feature_batch_html").html_safe %></span>
          </li>
          <li class="flex items-center gap-3 text-sm font-medium text-base-content">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span><%= t("pricing.pro.feature_size_html").html_safe %></span>
          </li>
          <li class="flex items-center gap-3 text-sm font-medium text-base-content">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/15">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <%= t("pricing.pro.feature_support") %>
          </li>
        </ul>

        <% if authenticated? && Current.user.subscribed? %>
          <%= link_to my_page_path, class: "btn btn-primary w-full shadow-sm shadow-primary/20" do %>
            <%= t("pricing.pro.button_current") %>
          <% end %>
        <% elsif authenticated? %>
          <%# Monthly checkout %>
          <div data-pricing-target="monthly"
               data-controller="paddle"
               data-paddle-client-token-value="<%= Rails.application.credentials.paddle&.dig(:client_token) %>"
               data-paddle-price-id-value="<%= Rails.application.credentials.paddle&.dig(:pro_price_id) %>"
               data-paddle-email-value="<%= Current.user.email_address %>"
               data-paddle-checkout-complete-url-value="<%= subscription_checkout_complete_path %>"
               data-paddle-sandbox-value="<%= Rails.application.credentials.paddle&.dig(:sandbox) %>"
               data-paddle-auto-open-value="<%= params[:checkout] == '1' %>">
            <button class="btn btn-primary w-full shadow-sm shadow-primary/20"
                    data-action="click->paddle#openCheckout">
              <%= t("pricing.pro.button_get") %>
            </button>
          </div>
          <%# Yearly checkout %>
          <div class="hidden" data-pricing-target="yearly"
               data-controller="paddle"
               data-paddle-client-token-value="<%= Rails.application.credentials.paddle&.dig(:client_token) %>"
               data-paddle-price-id-value="<%= Rails.application.credentials.paddle&.dig(:pro_yearly_price_id) %>"
               data-paddle-email-value="<%= Current.user.email_address %>"
               data-paddle-checkout-complete-url-value="<%= subscription_checkout_complete_path %>"
               data-paddle-sandbox-value="<%= Rails.application.credentials.paddle&.dig(:sandbox) %>"
               data-paddle-auto-open-value="false">
            <button class="btn btn-primary w-full shadow-sm shadow-primary/20"
                    data-action="click->paddle#openCheckout">
              <%= t("pricing.pro.button_get_yearly") %>
            </button>
          </div>
        <% else %>
          <%# Monthly login link %>
          <div data-pricing-target="monthly">
            <%= link_to login_path(return_to: pricing_path(checkout: "1")), class: "btn btn-primary w-full shadow-sm shadow-primary/20" do %>
              <%= t("pricing.pro.button_get") %>
            <% end %>
          </div>
          <%# Yearly login link %>
          <div class="hidden" data-pricing-target="yearly">
            <%= link_to login_path(return_to: pricing_path(checkout: "1", billing: "yearly")), class: "btn btn-primary w-full shadow-sm shadow-primary/20" do %>
              <%= t("pricing.pro.button_get_yearly") %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <%# Feature comparison table %>
  <div class="max-w-3xl mx-auto mb-24 px-4">
    <h2 class="text-2xl font-bold text-center mb-2"><%= t("pricing.compare.title") %></h2>
    <p class="text-center text-base-content/50 text-sm mb-10"><%= t("pricing.compare.subtitle") %></p>

    <%
      icon_check = '<span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-success/15"><svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg></span>'.html_safe
      icon_dash  = '<span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-base-200"><svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-base-content/25" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg></span>'.html_safe
    %>

    <div class="overflow-x-auto rounded-2xl border border-base-200 shadow-lg shadow-base-content/5">
      <table class="w-full text-sm">
        <colgroup>
          <col style="width:50%">
          <col style="width:25%">
          <col style="width:25%">
        </colgroup>
        <thead>
          <tr class="border-b border-base-200">
            <th class="px-6 py-5 text-left text-xs font-bold uppercase tracking-widest text-base-content/30 border-r border-base-200">
              <%= t("pricing.compare.feature") %>
            </th>
            <th class="px-4 py-5 text-center bg-base-200/30 border-r border-base-200/60">
              <span class="text-sm font-bold text-base-content/50"><%= t("pricing.free.label") %></span>
            </th>
            <th class="px-4 py-0 text-center bg-primary/5 relative">
              <div class="absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-primary/40 via-primary to-primary/40 rounded-t-sm"></div>
              <div class="py-5">
                <span class="inline-flex items-center gap-1.5 font-bold text-primary text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                  </svg>
                  <%= t("pricing.pro.label") %>
                </span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>

          <%# Batch tools %>
          <tr class="border-t border-base-200">
            <td colspan="3" class="px-6 py-2.5 bg-base-200/40">
              <span class="text-[11px] font-extrabold uppercase tracking-widest text-base-content/40"><%= t("pricing.compare.section_batch") %></span>
            </td>
          </tr>
          <% %w[compress resize convert exif].each do |tool| %>
          <tr class="border-t border-base-200 hover:bg-base-200/20 transition-colors">
            <td class="px-6 py-3.5 text-base-content/70 font-medium border-r border-base-200"><%= t("nav.#{tool}") %></td>
            <td class="px-4 py-3.5 text-center bg-base-200/20 border-r border-base-200/60">
              <span class="inline-block px-3 py-1 rounded-full bg-base-200 text-xs font-semibold text-base-content/50">
                <%= t("pricing.compare.batch_files", n: Task::BATCH_LIMIT_FREE) %>
              </span>
            </td>
            <td class="px-4 py-3.5 text-center bg-primary/5">
              <span class="inline-block px-3 py-1 rounded-full bg-primary/15 text-primary text-xs font-bold">
                <%= t("pricing.compare.batch_files", n: Task::BATCH_LIMIT_PRO) %>
              </span>
            </td>
          </tr>
          <% end %>

          <%# Single-image tools %>
          <tr class="border-t border-base-200">
            <td colspan="3" class="px-6 py-2.5 bg-base-200/40">
              <span class="text-[11px] font-extrabold uppercase tracking-widest text-base-content/40"><%= t("pricing.compare.section_single") %></span>
            </td>
          </tr>
          <% %w[crop rotate exif_edit].each do |tool| %>
          <tr class="border-t border-base-200 hover:bg-base-200/20 transition-colors">
            <td class="px-6 py-3.5 text-base-content/70 font-medium border-r border-base-200"><%= t("nav.#{tool}") %></td>
            <td class="px-4 py-3.5 text-center bg-base-200/20 border-r border-base-200/60">
              <span class="inline-block px-3 py-1 rounded-full bg-base-200 text-xs font-semibold text-base-content/50">
                <%= t("pricing.compare.single_image") %>
              </span>
            </td>
            <td class="px-4 py-3.5 text-center bg-primary/5">
              <span class="inline-block px-3 py-1 rounded-full bg-base-200 text-xs font-semibold text-base-content/50">
                <%= t("pricing.compare.single_image") %>
              </span>
            </td>
          </tr>
          <% end %>

          <%# Limits %>
          <tr class="border-t border-base-200">
            <td colspan="3" class="px-6 py-2.5 bg-base-200/40">
              <span class="text-[11px] font-extrabold uppercase tracking-widest text-base-content/40"><%= t("pricing.compare.section_limits") %></span>
            </td>
          </tr>
          <tr class="border-t border-base-200 hover:bg-base-200/20 transition-colors">
            <td class="px-6 py-3.5 text-base-content/70 font-medium border-r border-base-200"><%= t("pricing.compare.max_file_size") %></td>
            <td class="px-4 py-3.5 text-center bg-base-200/20 border-r border-base-200/60">
              <span class="inline-block px-3 py-1 rounded-full bg-base-200 text-xs font-semibold text-base-content/50">
                <%= Upload::MAX_FILE_SIZE / 1.megabyte %> MB
              </span>
            </td>
            <td class="px-4 py-3.5 text-center bg-primary/5">
              <span class="inline-block px-3 py-1 rounded-full bg-primary/15 text-primary text-xs font-bold">
                <%= Upload::MAX_FILE_SIZE_PRO / 1.megabyte %> MB
              </span>
            </td>
          </tr>
          <tr class="border-t border-base-200 hover:bg-base-200/20 transition-colors">
            <td class="px-6 py-3.5 text-base-content/70 font-medium border-r border-base-200"><%= t("pricing.compare.auto_delete") %></td>
            <td class="px-4 py-3.5 text-center bg-base-200/20 border-r border-base-200/60">
              <span class="inline-block px-3 py-1 rounded-full bg-base-200 text-xs font-semibold text-base-content/50">
                <%= t("pricing.compare.auto_delete_value") %>
              </span>
            </td>
            <td class="px-4 py-3.5 text-center bg-primary/5">
              <span class="inline-block px-3 py-1 rounded-full bg-base-200 text-xs font-semibold text-base-content/50">
                <%= t("pricing.compare.auto_delete_value") %>
              </span>
            </td>
          </tr>

          <%# Privacy %>
          <tr class="border-t border-base-200">
            <td colspan="3" class="px-6 py-2.5 bg-base-200/40">
              <span class="text-[11px] font-extrabold uppercase tracking-widest text-base-content/40"><%= t("pricing.compare.section_privacy") %></span>
            </td>
          </tr>
          <tr class="border-t border-base-200 hover:bg-base-200/20 transition-colors">
            <td class="px-6 py-3.5 text-base-content/70 font-medium border-r border-base-200"><%= t("pricing.compare.no_ads") %></td>
            <td class="px-4 py-3.5 text-center bg-base-200/20 border-r border-base-200/60"><%= icon_check %></td>
            <td class="px-4 py-3.5 text-center bg-primary/5"><%= icon_check %></td>
          </tr>
          <tr class="border-t border-base-200 hover:bg-base-200/20 transition-colors">
            <td class="px-6 py-3.5 text-base-content/70 font-medium border-r border-base-200"><%= t("pricing.compare.no_account") %></td>
            <td class="px-4 py-3.5 text-center bg-base-200/20 border-r border-base-200/60"><%= icon_check %></td>
            <td class="px-4 py-3.5 text-center bg-primary/5"><%= icon_dash %></td>
          </tr>

          <%# Support %>
          <tr class="border-t border-base-200">
            <td colspan="3" class="px-6 py-2.5 bg-base-200/40">
              <span class="text-[11px] font-extrabold uppercase tracking-widest text-base-content/40"><%= t("pricing.compare.section_support") %></span>
            </td>
          </tr>
          <tr class="border-t border-base-200 hover:bg-base-200/20 transition-colors">
            <td class="px-6 py-3.5 text-base-content/70 font-medium border-r border-base-200"><%= t("pricing.compare.priority_support") %></td>
            <td class="px-4 py-3.5 text-center bg-base-200/20 border-r border-base-200/60"><%= icon_dash %></td>
            <td class="px-4 py-3.5 text-center bg-primary/5"><%= icon_check %></td>
          </tr>

        </tbody>
      </table>
    </div>
  </div>

  <%# FAQ %>
  <div class="px-4">
    <%= render "faq" %>
  </div>

</div>
